# Crypto Helper settings. Copy to `.env` (a development checkout) or see
# /etc/crypto-helper/config.env (an installed service: change it with `crypto-helper config`).
# Every line is commented out: the value shown is the default. Full reference:
# WIKI/reference/configuration.md (or Help → Reference → Configuration in the app).
#
# Never put this file, with real values, in git: it can hold secrets (.env is ignored).

# ---- storage ---------------------------------------------------------------------------------
# Where the database is.
# BOT_DATABASE_URL=sqlite:///data/bot.db
# Runtime files: the one-time setup token, the default backup folder, the self-test result.
# BOT_STATE_DIR=data

# ---- secrets ---------------------------------------------------------------------------------
# The key that encrypts secrets at rest (2FA secrets, Discord webhooks). Either the key itself...
# BOT_SECRET_KEY=
# ...or a file holding it, created (mode 0600) on first start if missing. Back it up separately
# from the database.
# BOT_SECRET_KEY_FILE=~/.config/crypto-helper/secret.key

# ---- sign-in ---------------------------------------------------------------------------------
# Set to true whenever it's served over HTTPS (Tailscale, Cloudflare Access...).
# BOT_COOKIE_SECURE=false
# BOT_SESSION_HOURS=12
# super must turn on two-factor login before using anything else. Leave it on (tests only).
# BOT_SUPER_REQUIRES_TWO_FACTOR=true
# Wrong passwords or codes in a row before an account is locked, and for how long.
# BOT_MAX_FAILED_LOGINS=5
# BOT_LOCKOUT_MINUTES=15

# ---- where it listens ------------------------------------------------------------------------
# Address(es) to listen on, comma-separated, e.g. 127.0.0.1,100.64.39.116 (NetBird).
# 0.0.0.0 / :: are always refused.
# BOT_HOST=127.0.0.1
# BOT_PORT=8000
# Needed for any address in BOT_HOST beyond this machine.
# BOT_ALLOW_REMOTE_BIND=false
# Clients allowed to connect (addresses or networks); everything else gets 403.
# BOT_ALLOWED_NETWORKS=127.0.0.0/8,::1/128

# ---- prices ----------------------------------------------------------------------------------
# coingecko, or mock (made-up prices, for development and tests).
# BOT_PRICE_PROVIDER=coingecko
# Optional free CoinGecko "Demo" key for higher rate limits. Never logged.
# BOT_COINGECKO_API_KEY=
# Only change for testing.
# BOT_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Daily prices (years back) from Coinbase's public price history. Only change for testing.
# BOT_DAILY_PRICES_URL=https://api.exchange.coinbase.com
# How long one price snapshot is shared, and how long to wait for CoinGecko.
# BOT_PRICE_CACHE_SECONDS=60
# BOT_PRICE_TIMEOUT_SECONDS=10
# Record price history and check price alerts in the background.
# BOT_PRICE_BACKGROUND=true

# ---- notifications ---------------------------------------------------------------------------
# Send Discord notifications and watch system health from background jobs.
# BOT_NOTIFY_BACKGROUND=true

# ---- syncing wallets (exchanges and addresses) ----------------------------------------------
# Sync wallets in the background (how often: Settings → Connections).
# BOT_SYNC_BACKGROUND=true
# Offer a pretend "Demo exchange" (no network) for trying the screens out and for tests.
# BOT_SYNC_DEMO=false

# ---- paper trading ---------------------------------------------------------------------------
# Readiness test clock: a day is a minute (development and test servers only; the server won't
# start with it on an install's own database, and it never allows live trading).
# BOT_READINESS_TEST_CLOCK=false

# ---- the embed server (crypto-helper embed enable|disable) ----------------------------------
# BOT_EMBED_ENABLED=false
# "main": the same address(es) as the web UI. Or a comma-separated list of its own.
# BOT_EMBED_HOST=main
# BOT_EMBED_PORT=8001
# Needed for addresses of its own beyond this machine (not for "main").
# BOT_EMBED_ALLOW_PUBLIC=false
# The address people reach embeds at, e.g. a tunnel's https://embed.example.com.
# BOT_EMBED_PUBLIC_URL=
# Who may load embeds (* = anyone), and requests per minute per address.
# BOT_EMBED_ALLOWED_NETWORKS=*
# BOT_EMBED_RATE_PER_MINUTE=120

# ---- services (switched in the Services window, through the agent) --------------------------
# BOT_CONSOLE_ENABLED=false
# BOT_TERMINAL_ENABLED=false
# The agent's socket (crypto-helper agent enable).
# BOT_AGENT_SOCKET=/run/crypto-helper-agent/agent.sock
