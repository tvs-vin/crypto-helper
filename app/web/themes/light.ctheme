{
  "format": "crypto-helper-theme",
  "version": 1,
  "name": "Light",
  "author": "Crypto Helper",
  "description": "The same design language on a light background.",
  "mode": "light",
  "colors": {
    "desktop": "#F4F3F9",
    "desktop_glow": "#7545FC",
    "surface": "#FFFFFF",
    "surface_alt": "#F7F6FC",
    "titlebar": "#FAFAFD",
    "titlebar_active": "#F1EEFD",
    "taskbar": "#FFFFFF",
    "border": "#E4E0F3",
    "border_strong": "#CBC3EC",
    "text": "#45455E",
    "text_muted": "#7A7A94",
    "heading": "#0C0C13",
    "accent": "#6234E8",
    "accent_hover": "#5222D6",
    "accent_text": "#FFFFFF",
    "positive": "#14855C",
    "negative": "#C9303D",
    "warning": "#A86A07",
    "focus": "#6234E8",
    "overlay": "#E9E7F2D9",
    "selection": "#6234E833"
  },
  "fonts": { "body": "Inter", "heading": "Mona Sans", "mono": "JetBrains Mono" },
  "shape": { "radius": 6, "window_radius": 8, "border_width": 1 },
  "effects": { "glow": true, "shadow": "soft" },
  "density": "comfortable"
}
